{
  "name": "HERQ Build & Deploy Scripts",
  "version": "1.0.0",
  "description": "Easy-to-use scripts for HERQ development, building, and deployment",
  "scripts": {
    "dev": "Run development on emulator",
    "emulator": "Run development on emulator (alias for dev)",
    "apk": "Build Android APK release",
    "android": "Build Android APK release (alias for apk)",
    "ios": "Build iOS release",
    "apple": "Build iOS release (alias for ios)",
    "web": "Build Web for GitHub Pages",
    "gh-pages": "Build Web for GitHub Pages (alias for web)",
    "deploy": "Deploy to GitHub Pages",
    "publish": "Deploy to GitHub Pages (alias for deploy)",
    "help": "Show all available commands"
  },
  "usage": {
    "master": "./build.sh [command]",
    "individual": "./[script_name].sh",
    "examples": [
      "./build.sh dev",
      "./build.sh apk", 
      "./build.sh deploy",
      "./run_dev.sh",
      "./build_apk.sh"
    ]
  },
  "requirements": {
    "env_file": ".env",
    "required_vars": [
      "SUPABASE_URL",
      "SUPABASE_ANON_KEY", 
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "optional_vars": [
      "GITHUB_TOKEN (for deployment)"
    ]
  },
  "outputs": {
    "dev": "Live app on emulator",
    "apk": "build/app/outputs/flutter-apk/app-release.apk",
    "ios": "build/ios/",
    "web": "build/web/",
    "deploy": "Live at https://herq.app"
  }
}
